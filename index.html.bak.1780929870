<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<meta name="description" content="爱玩桌游club 自动整理新物集、摩点、Kickstarter、Gamefound 的桌游众筹动态。">
<meta name="theme-color" content="#f5f5f7">
<link rel="canonical" href="https://aiwanlands.com/">
<meta property="og:title" content="爱玩桌游 众筹资讯">
<meta property="og:description" content="每日整理国内外桌游众筹项目、开售提醒和关键时间节点。">
<meta property="og:url" content="https://aiwanlands.com/">
<meta property="og:type" content="website">
<title>🎲 爱玩桌游 众筹资讯</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{--bg:#f5f5f7;--card:#fff;--accent:#e94560;--accent2:#ff6b6b;--gold:#d4a843;--blue:#6c5ce7;--text:#1d1d1f;--muted:#86868b;--border:rgba(0,0,0,.08);--radius:14px}
body{background:var(--bg);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display","PingFang SC",sans-serif;padding:16px;min-height:100vh;line-height:1.5}
button{font:inherit}
.container{max-width:960px;margin:0 auto}
header{text-align:center;padding:26px 16px 12px}
header h1{font-size:1.6em;font-weight:800;color:var(--text);background:none;margin-bottom:4px;letter-spacing:0}
header p{color:var(--muted);font-size:.85em}
.search-wrap{position:relative;max-width:620px;margin:16px auto 4px;display:flex;gap:8px;align-items:center;transition:max-width .28s ease,gap .28s ease}
.search-input{width:100%;height:42px;border:1px solid var(--border);border-radius:22px;background:#fff;padding:0 44px 0 18px;color:var(--text);box-shadow:0 4px 18px rgba(0,0,0,.05);outline:none;transition:border-color .2s,box-shadow .2s,border-radius .28s ease}
.search-input:focus{border-color:rgba(233,69,96,.45);box-shadow:0 6px 24px rgba(233,69,96,.12)}
.search-box{position:relative;flex:1;min-width:0}
.search-icon{position:absolute;right:16px;top:50%;transform:translateY(-50%);color:var(--muted);font-size:.9em}
.add-game-btn{height:42px;border-radius:22px;border:1px solid rgba(233,69,96,.2);background:#fff0f4;color:var(--accent);font-size:.82em;font-weight:700;line-height:1;cursor:pointer;box-shadow:0 4px 18px rgba(233,69,96,.12);flex-shrink:0;padding:0 14px;transition:all .28s ease;white-space:nowrap}
.add-game-btn:hover{background:var(--accent);border-color:var(--accent);color:#fff}
.search-wrap.add-mode{max-width:760px;gap:0}
.search-wrap.add-mode .search-input{border-color:rgba(233,69,96,.55);border-top-right-radius:0;border-bottom-right-radius:0;box-shadow:0 8px 28px rgba(233,69,96,.16)}
.search-wrap.add-mode .add-game-btn{background:var(--accent);border-color:var(--accent);color:#fff;border-top-left-radius:0;border-bottom-left-radius:0;padding:0 18px}
.search-results{position:absolute;left:0;right:0;top:48px;background:#fff;border:1px solid var(--border);border-radius:14px;box-shadow:0 14px 36px rgba(0,0,0,.12);overflow:hidden;z-index:50;display:none;text-align:left}
.search-results.open{display:block}
.search-result{width:100%;border:0;background:#fff;color:var(--text);padding:10px 14px;text-align:left;cursor:pointer;border-bottom:1px solid rgba(0,0,0,.05)}
.search-result:last-child{border-bottom:0}
.search-result:hover,.search-result:focus-visible{background:#fff4f6;outline:none}
.search-result strong{display:block;font-size:.84em}
.search-result span{display:block;color:var(--muted);font-size:.72em;margin-top:2px}
.tab-bar{display:flex;justify-content:center;gap:8px;margin:14px 0}
.tab-btn{padding:8px 26px;border-radius:999px;border:1.5px solid #ddd;background:#fff;color:var(--muted);font-size:.88em;font-weight:500;cursor:pointer;transition:all .25s}
.tab-btn.active{background:var(--accent);color:#fff;border-color:var(--accent);box-shadow:0 4px 16px rgba(233,69,96,.25)}
.tab-btn:focus-visible,.share-btn:focus-visible,.qr-btn:focus-visible,.add-game-btn:focus-visible,.feedback-input:focus-visible,.feedback-textarea:focus-visible,.modal-close:focus-visible,.feedback-link:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
.tab-content{display:none}.tab-content.active{display:block;animation:fadeIn .3s}
@keyframes fadeIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}
.sec{display:flex;align-items:center;gap:8px;margin:22px 0 10px;padding-left:10px;border-left:3px solid var(--accent)}
.sec h2{font-size:1.05em;font-weight:600}
.sec .bc{font-size:.7em;color:var(--muted);margin-left:auto;background:#f0f0f2;padding:2px 10px;border-radius:12px}
.card{background:var(--card);border-radius:var(--radius);padding:0;margin-bottom:10px;box-shadow:0 2px 12px rgba(0,0,0,.06);border:1px solid rgba(0,0,0,.04);transition:transform .2s,box-shadow .2s,border-color .2s;contain:layout paint;overflow:hidden}
.card:hover{transform:translateY(-2px);box-shadow:0 8px 30px rgba(0,0,0,.1);border-color:rgba(233,69,96,.15)}
.cl{display:block;text-decoration:none;color:inherit}
.cr{display:flex;gap:14px;align-items:flex-start;width:100%;padding:12px;border:0;background:transparent;color:inherit;text-align:left;cursor:pointer}
.ciw{flex-shrink:0;width:220px;height:auto;aspect-ratio:16/9;border-radius:10px;overflow:hidden;background:#f0f0f2;display:flex;align-items:center;justify-content:center;font-size:2em;color:#bbb}
.ciw img{width:100%;height:100%;object-fit:cover;object-position:top;transition:transform .4s}
.card:hover .ciw img{transform:scale(1.08)}
.card.funding-card .cr{display:block;padding:0}
.card.funding-card .ciw{width:100%;min-width:0;border-radius:0;aspect-ratio:2.55/1;margin:0}
.card.funding-card .ciw img{object-fit:cover;object-position:center;background:#f0f0f2}
.card.funding-card .cif{padding:10px 14px 14px}
.card.upcoming-card .ciw,.card.ended-card .ciw{width:132px;aspect-ratio:1/1;border-radius:12px}
.card.upcoming-card .ciw img,.card.ended-card .ciw img{object-fit:cover;object-position:center}
.card.upcoming-card .cr,.card.ended-card .cr{gap:12px}
.cif{flex:1;min-width:0}
.ct{font-size:1.06em;font-weight:600;line-height:1.43}
.ct .cn{font-size:.72em;color:var(--muted);font-weight:400;display:inline}
.ct .title-tail{font-size:.86em;color:var(--muted);font-weight:500}
.cm{font-size:.76em;color:var(--muted);margin-bottom:2px}
.ctg{display:inline-block;padding:2px 10px;border-radius:20px;font-size:.66em;margin-top:3px;margin-right:4px;font-weight:500}
.ctg.h{background:#ffe8ec;color:#e94560}
.ctg.u{background:#fff8e1;color:#b8860b}
.ctg.l{background:#e8f5e9;color:#2e7d32}
.ctg.e{background:#fff0e0;color:#e67e22}
.pr{color:var(--gold);font-weight:600;font-size:.82em}
.progress-row{display:flex;align-items:center;gap:8px;margin-top:7px}
.pb{height:5px;background:#f0f0f2;border-radius:3px;overflow:hidden;flex:1;min-width:70px}
.pbf{height:100%;background:linear-gradient(90deg,var(--accent),var(--gold));border-radius:3px}
.progress-text{font-size:.68em;color:var(--muted);white-space:nowrap}
.p2{display:inline-flex;padding:2px 8px;border-radius:20px;font-size:.63em;margin-top:3px;margin-right:3px;font-weight:500}
.p2.gf{background:#f0edff;color:#6c5ce7}
.p2.ks{background:#e6faf2;color:#00875a}
.p2.xwj{background:#ffe8ec;color:#e94560}
.p2.md{background:#fff8e1;color:#b8860b}
.today-badge{display:inline-flex;align-items:center;padding:2px 8px;border-radius:99px;background:#e94560;color:#fff;font-size:.64em;font-weight:600;margin-left:4px}
.card-detail{display:none;padding:0 14px 14px;border-top:1px solid rgba(0,0,0,.06);background:linear-gradient(180deg,#fff,#fafafa)}
.card.open .card-detail{display:block}
.detail-copy{font-size:.82em;color:#3a3a3c;line-height:1.65;padding-top:10px}
.detail-link{display:inline-flex;color:var(--accent);font-size:.78em;text-decoration:none;font-weight:600}
.detail-actions{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:10px;min-height:30px}
.card-title-line{display:flex;align-items:center;gap:8px;min-width:0}
.card-title-line .title-main{min-width:0;flex:1}
.heat-badge{display:inline-flex;align-items:center;height:20px;padding:0 8px;border-radius:999px;background:#fff4f6;color:var(--accent);font-size:.64em;font-weight:700;white-space:nowrap}
.engagement-row{display:flex;align-items:center;gap:7px;opacity:.48;transition:opacity .2s}
.card-detail:hover .engagement-row{opacity:.9}
.vote-btn{width:28px;height:28px;border:0;border-radius:0;background:transparent;color:var(--accent);padding:0;font-size:18px;line-height:1;cursor:pointer;transition:transform .18s ease,opacity .18s ease,filter .18s ease;box-shadow:none;filter:saturate(.75);transform-origin:center}
.vote-btn:hover{opacity:1;transform:translateY(-1px) scale(1.12);filter:saturate(1.05)}
.vote-btn:active{transform:scale(.82)}
.vote-btn.active{opacity:1;filter:saturate(1.15);animation:votePop .34s ease}
.vote-btn.down{color:#6c5ce7}
.vote-btn.down:hover,.vote-btn.down.active{color:#6c5ce7}
@keyframes votePop{0%{transform:scale(.75)}55%{transform:scale(1.22)}100%{transform:scale(1)}}
.rules-slot{margin-top:10px;padding:10px;border:1px dashed rgba(0,0,0,.12);border-radius:10px;background:#fff;color:var(--muted);font-size:.76em}
.rules-slot a{color:var(--accent);text-decoration:none;font-weight:600}
.section-tools{display:flex;align-items:center;gap:8px;margin:-4px 0 10px;flex-wrap:wrap}
.sort-btn{border:1px solid var(--border);background:#fff;color:var(--muted);border-radius:99px;padding:5px 12px;font-size:.72em;cursor:pointer}
.sort-btn.active{background:#1d1d1f;color:#fff;border-color:#1d1d1f}
.more-btn{width:100%;border:1px dashed rgba(233,69,96,.35);background:#fff;color:var(--accent);border-radius:12px;padding:9px 12px;margin:4px 0 10px;cursor:pointer;font-size:.82em;font-weight:600}
.highlight-card{animation:focusFlash 1.4s ease}
@keyframes focusFlash{0%,100%{box-shadow:0 2px 12px rgba(0,0,0,.06)}30%{box-shadow:0 0 0 4px rgba(233,69,96,.22),0 8px 30px rgba(0,0,0,.12)}}
.g3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px}
.mc{background:var(--card);border-radius:12px;padding:10px;text-align:center;box-shadow:0 2px 12px rgba(0,0,0,.06);transition:transform .2s;contain:layout paint}
.mc:hover{transform:translateY(-2px)}
.mc .mi{width:100%;height:80px;border-radius:8px;object-fit:cover;margin-bottom:4px;background:#f0f0f2}
.mc .mi img{width:100%;height:100%;object-fit:cover;border-radius:8px}
.mc .mn{font-size:.72em;font-weight:500;line-height:1.3;color:var(--text)}
.mc .mm{font-size:.63em;color:var(--muted);margin-top:2px}
.mc a{color:inherit;text-decoration:none;display:block}
.tl{position:relative;padding-left:22px}
.tl::before{content:"";position:absolute;left:8px;top:4px;bottom:4px;width:2px;background:linear-gradient(180deg,var(--accent),var(--gold))}
.tli{position:relative;margin-bottom:10px}
.tli::before{content:"";position:absolute;left:-18px;top:6px;width:7px;height:7px;border-radius:50%;background:var(--accent);border:2px solid var(--bg);box-shadow:0 0 0 2px var(--accent)}
.tli .td{color:var(--accent);font-weight:600;font-size:.78em}
.tli .te{font-size:.82em;line-height:1.4}
.tli.dn{opacity:.5}
.tli.dn::before{background:var(--muted);box-shadow:0 0 0 2px var(--muted)}
.tli.td::before{background:var(--gold);box-shadow:0 0 0 2px var(--gold)}
footer{text-align:center;padding:24px 16px;color:var(--muted);font-size:.78em;line-height:1.6}
footer a{color:var(--accent);text-decoration:none}
.feedback-row{display:grid;grid-template-columns:1fr auto;gap:8px;margin-top:8px}
.feedback-input,.feedback-textarea{width:100%;border:1px solid var(--border);border-radius:10px;background:#fafafa;color:var(--text);padding:9px 10px;font:inherit;font-size:.84em;outline:none}
.feedback-textarea{min-height:74px;resize:vertical}
.feedback-submit{border:0;border-radius:10px;background:var(--accent);color:#fff;padding:0 16px;cursor:pointer;font-weight:600}
.feedback-link{border:0;background:transparent;color:var(--accent);cursor:pointer;font:inherit;text-decoration:none}
.footer-qr{margin:16px auto 0;width:156px;background:#fff;border:1px solid var(--border);border-radius:14px;padding:10px;box-shadow:0 2px 12px rgba(0,0,0,.05)}
.footer-qr #qr_canvas{width:136px;height:136px;margin:auto;display:flex;align-items:center;justify-content:center}
.footer-qr #qr_canvas canvas,.footer-qr #qr_canvas img{width:136px;height:136px;border-radius:6px}
.modal-backdrop{position:fixed;inset:0;background:rgba(0,0,0,.38);display:none;align-items:center;justify-content:center;z-index:1000;padding:16px}
.modal-backdrop.open{display:flex}
.modal-card{width:min(520px,100%);max-height:min(82vh,680px);overflow:auto;background:#fff;border-radius:16px;padding:18px;box-shadow:0 24px 80px rgba(0,0,0,.25)}
.modal-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}
.modal-head h2{font-size:1.02em}
.modal-close{min-width:32px;height:32px;border-radius:16px;border:1px solid var(--border);background:#fff;cursor:pointer;padding:0 10px}
.share-modal-card{width:min(560px,100%);max-height:min(88vh,760px);overflow:auto;padding:14px}
.share-preview-box{border-radius:12px;overflow:hidden;background:#f5f5f7;border:1px solid var(--border)}
.share-preview-box img{display:block;width:100%;height:auto}
.share-modal-actions{display:flex;gap:8px;justify-content:flex-end;margin-top:10px;flex-wrap:wrap}
.share-modal-actions button,.share-modal-actions a{border:1px solid var(--border);background:#fff;color:var(--text);border-radius:999px;padding:6px 12px;font-size:12px;text-decoration:none;cursor:pointer}
.share-modal-actions .primary{background:var(--accent);border-color:var(--accent);color:#fff}
.share-hint{font-size:12px;color:var(--muted);margin:4px 0 10px}
.form-grid{display:grid;gap:9px}
.form-grid label{font-size:.76em;color:var(--muted);display:grid;gap:4px;text-align:left}
@media(max-width:640px){
  .cr{flex-direction:row;gap:8px}
  .ciw{width:132px;flex-shrink:0;border-radius:10px}
  .card.funding-card .ciw{width:100%;min-width:0}
  .ct{font-size:.96em}
  .ct .cn{font-size:.68em}
  .cm{font-size:.7em}
  .pr{font-size:.76em}
  .g3{grid-template-columns:1fr 1fr;gap:6px}
  .mc .mi{height:70px}
  .mc .mn{font-size:.68em}
  .mc .mm{font-size:.6em}
  .tab-btn{padding:6px 18px;font-size:.82em}
  .tab-bar{flex-wrap:wrap}
  header h1{font-size:1.35em}
  header p{font-size:.78em}
  .sec h2{font-size:.95em}
  .sec .bc{font-size:.65em}
  .tli .td{font-size:.72em}
  .tli .te{font-size:.76em}
  .dciw{height:auto;aspect-ratio:16/9}
  .dct{font-size:.7em;padding:4px 6px 1px}
  .dcm{font-size:.58em;padding:0 6px 6px}
  .dciw-badge{font-size:.55em}
  .daily{padding:12px}
  .daily-cards{grid-template-columns:1fr;gap:8px}
  .dh{font-size:.76em}
  .feedback-row{grid-template-columns:1fr}
  .feedback-submit{height:38px}
  body{padding:10px}
}
@media(max-width:420px){
  .ciw{width:124px}
  .ct{font-size:.9em}
  .g3{grid-template-columns:1fr 1fr;gap:4px}
}
@media(max-width:380px){.g3{grid-template-columns:1fr}}
.daily-news-page{min-height:200px}
.daily-cards{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.daily-card{background:rgba(255,255,255,.06);border:0;border-radius:10px;overflow:hidden;transition:all .2s;text-decoration:none;color:inherit;display:block;width:100%;text-align:left;font:inherit;cursor:pointer}
.daily-card:hover{background:rgba(255,255,255,.1);transform:translateY(-2px)}
.dciw{position:relative;width:100%;height:auto;aspect-ratio:16/9;overflow:hidden;background:#2a2a3e;display:flex;align-items:center;justify-content:center}
.dciw img{width:100%;height:100%;object-fit:cover;object-position:top}
.dciw-overlay{position:absolute;inset:0;background:linear-gradient(transparent 50%,rgba(0,0,0,.6))}
.dciw-badge{position:absolute;bottom:4px;left:6px;font-size:.6em;font-weight:600;background:rgba(0,0,0,.55);padding:2px 7px;border-radius:4px;color:#fff;backdrop-filter:blur(2px)}
.dct{padding:6px 8px 1px;font-size:.75em;font-weight:600;line-height:1.25;color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.dct .dcs-inline{font-size:.78em;color:rgba(255,255,255,.64);font-weight:500}
.dcs{padding:0 8px 1px;font-size:.58em;line-height:1.2;color:rgba(255,255,255,.64);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.dcm{padding:0 8px 1px;font-size:.62em;color:var(--muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.dcv{padding:0 8px 8px;font-size:.6em;color:rgba(255,255,255,.86);font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
/* 每日资讯在暗色背景中的样式修复 */
.daily .dct{color:#fff;font-weight:600}
.daily .dcm{color:rgba(255,255,255,.76)}
.daily-card{background:rgba(255,255,255,.08)}
.daily-card:hover{background:rgba(255,255,255,.12)}
.daily{background:linear-gradient(135deg,#1a1a2e,#2a1a2e);border-radius:var(--radius);padding:16px;margin-bottom:12px;color:#fff}
.dh{font-size:.82em;color:rgba(255,255,255,.78);margin-bottom:10px;display:flex;align-items:center;gap:6px}
.dh .sub{font-size:.82em;color:rgba(255,255,255,.58);font-weight:400}
.dg{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.dc{background:rgba(255,255,255,.06);border-radius:10px;padding:10px;transition:all .2s}
.dc:hover{background:rgba(255,255,255,.1);transform:translateY(-1px)}
.dt{display:inline-block;padding:1px 8px;border-radius:6px;font-size:.65em;font-weight:500;margin-bottom:4px}
.dt.d{background:#e94560;color:#fff}
.dt.s{background:#d4a843;color:#1a1a2e}
.dt.i{background:rgba(255,255,255,.08);color:rgba(255,255,255,.3)}
.dn{font-size:.78em;font-weight:500;line-height:1.3}
.dm{font-size:.65em;color:rgba(255,255,255,.4);margin-top:2px}
.dcnt{font-size:.6em;color:rgba(255,255,255,.5);margin-top:3px}
.daily-stack .daily:first-child{border-bottom-left-radius:0;border-bottom-right-radius:0}
.daily-stack .daily:last-child{border-top-left-radius:0;border-top-right-radius:0}
/* ===== 文字滚动榜单 ===== */
.rank-scroll-wrap{border-radius:12px;overflow:hidden;background:linear-gradient(135deg,rgba(233,69,96,.18),rgba(212,168,67,.1));cursor:pointer}
.rank-scroll-head{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:6px;align-items:center;padding:9px 10px 4px;color:rgba(255,255,255,.9)}
.rank-scroll-title{display:flex;align-items:center;gap:4px;min-width:0;font-size:12px;font-weight:700;white-space:nowrap}
.rank-scroll-head .rank-toggle{display:inline-flex;gap:3px;background:rgba(255,255,255,.1);padding:3px;border-radius:999px;white-space:nowrap}
.rank-scroll-head .rank-toggle button{border:0;border-radius:999px;background:transparent;color:rgba(255,255,255,.65);font-size:10px;line-height:1;padding:4px 8px;cursor:pointer;transition:all .2s;white-space:nowrap}
.rank-scroll-head .rank-toggle button.active{background:#fff;color:#1d1d1f}
.rank-scroll-inner{display:grid;gap:4px;max-height:132px;overflow-y:auto;overflow-x:hidden;padding:3px 10px 10px;overscroll-behavior:contain;-webkit-overflow-scrolling:touch;scrollbar-width:thin;scrollbar-color:rgba(255,255,255,.28) transparent}
.rank-scroll-inner::-webkit-scrollbar{width:3px}
.rank-scroll-inner::-webkit-scrollbar-thumb{background:rgba(255,255,255,.25);border-radius:99px}
.rank-scroll-item{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:3px 8px;align-items:center;width:100%;border:0;border-bottom:1px solid rgba(255,255,255,.08);background:transparent;color:inherit;text-align:left;font:inherit;cursor:default;padding:4px 0 7px}
.rank-scroll-item:last-child{border-bottom:0}
.rank-scroll-no{font-size:10px;font-weight:700;color:rgba(255,255,255,.7);white-space:nowrap}
.rank-scroll-name{font-size:11px;font-weight:700;line-height:1.2;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.rank-scroll-value{font-size:10px;color:rgba(255,255,255,.78);font-weight:600;white-space:nowrap}
.rank-scroll-bar{grid-column:1/4;height:4px;border-radius:99px;background:rgba(255,255,255,.16);overflow:hidden}
.rank-scroll-bar-fill{display:block;height:100%;min-width:5px;border-radius:99px;background:linear-gradient(90deg,#e94560,#d4a843);transition:width .4s ease}
.rank-scroll-empty{padding:12px 10px 14px;font-size:11px;color:rgba(255,255,255,.5);text-align:center}
@media(min-width:900px){.rank-scroll-inner{max-height:166px}}
/* 旧榜单样式保留（弹窗和页面其他引用的 rank-row 等不变） */
.rank-item{display:flex;gap:6px;align-items:center;text-decoration:none;color:inherit;background:#fafafa;border:1px solid rgba(0,0,0,.04);border-radius:9px;padding:5px}
.rank-no{width:20px;height:20px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#1d1d1f;color:#fff;font-size:.62em;font-weight:700;flex-shrink:0}
.rank-thumb{width:46px;aspect-ratio:16/9;border-radius:6px;overflow:hidden;background:#ececef;flex-shrink:0}
.rank-thumb img{width:100%;height:100%;object-fit:cover}
.rank-name{font-size:11px;font-weight:600;line-height:1.25;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.rank-meta{font-size:10px;color:var(--muted);margin-top:1px}
.rank-modal-tools{display:flex;gap:6px;margin-bottom:10px}
.rank-modal-tools button{border:1px solid var(--border);background:#fff;color:var(--muted);border-radius:999px;padding:5px 12px;font-size:12px;cursor:pointer}
.rank-modal-tools button.active{background:var(--accent);border-color:var(--accent);color:#fff}
.rank-modal-list{display:grid;gap:8px}
.rank-modal-list .rank-item{cursor:pointer;width:100%;text-align:left}
.rank-modal-list .rank-item.active{background:#fff4f6;border-color:rgba(233,69,96,.32)}
.rank-row-copy .rank-meta{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.rank-row{background:#fafafa;border:1px solid rgba(0,0,0,.05);border-radius:14px;overflow:hidden}
.rank-row .rank-item{background:transparent;border:0;border-radius:0}
.rank-row .rank-item{padding:8px 9px}
.rank-row-main{display:grid;grid-template-columns:24px 86px minmax(0,1fr);gap:10px;align-items:center;width:100%;min-width:0}
.rank-row-main .rank-no{width:24px;height:24px;font-size:11px}
.rank-row-main .rank-thumb{width:86px;border-radius:8px}
.rank-row-copy{min-width:0}
.rank-row-copy .rank-name{font-size:13px;margin-bottom:1px}
.rank-row-copy .rank-meta{font-size:11px}
.rank-row-progress{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px;align-items:center;margin-top:7px}
.rank-row-progress .mini-track{height:7px}
.rank-expand{display:none;border-top:1px solid rgba(0,0,0,.05);padding:8px 10px 10px;background:#fff}
.rank-row.open .rank-expand{display:block}
.rank-more{width:100%;border:1px dashed rgba(233,69,96,.35);background:#fff;color:var(--accent);border-radius:12px;padding:8px;margin-top:8px;font-size:12px;font-weight:700;cursor:pointer}
.mini-track{height:6px;border-radius:99px;background:#ececef;overflow:hidden}
.mini-fill{height:100%;border-radius:99px;background:linear-gradient(90deg,var(--accent),var(--gold))}
.growth-title{font-size:12px;font-weight:700;margin:4px 0 6px}
.growth-chart{width:100%;height:132px;background:#fff;border:1px solid rgba(0,0,0,.04);border-radius:10px;overflow:hidden}
.growth-note{font-size:10px;color:var(--muted);margin-top:6px;line-height:1.4}
.rank-project-link{margin-top:8px;border:0;border-radius:999px;background:var(--accent);color:#fff;padding:6px 12px;font-size:12px;font-weight:700;cursor:pointer}
@media(max-width:640px){.rank-grid{grid-template-columns:1fr}.search-wrap{margin-top:12px}.search-input{height:40px}.rank-row-main{grid-template-columns:24px 82px minmax(0,1fr);gap:9px}.rank-row-main .rank-thumb{width:82px}.rank-row-copy .rank-name{font-size:12.5px}.rank-row-copy .rank-meta{font-size:10.5px}}
@media(max-width:380px){.rank-row-main{grid-template-columns:22px 76px minmax(0,1fr);gap:8px}.rank-row-main .rank-no{width:22px;height:22px;font-size:10px}.rank-row-main .rank-thumb{width:76px}}
.share-bar{display:flex;justify-content:center;align-items:center;gap:10px;margin-top:14px;padding-top:14px;border-top:1px solid var(--border)}
.share-btn,.qr-btn{cursor:pointer;display:inline-flex;align-items:center;gap:5px;padding:6px 16px;border-radius:20px;font-size:.78em;background:var(--card);border:1px solid var(--border);color:var(--text);transition:all .2s}
.share-btn:hover,.qr-btn:hover{background:var(--accent);color:#fff;border-color:var(--accent)}
.share-btn:active,.qr-btn:active{transform:scale(.95)}
.qr-wrap{position:relative}
.qr-dropdown{position:absolute;bottom:100%;left:50%;transform:translateX(-50%) translateY(-8px);background:var(--card);border:1px solid var(--border);border-radius:12px;padding:14px;box-shadow:0 8px 32px rgba(0,0,0,.12);display:none;z-index:100}
.qr-wrap.open .qr-dropdown{display:block}
.qr-dropdown #qr_canvas{width:140px;height:140px;display:flex;align-items:center;justify-content:center}
.qr-dropdown #qr_canvas img{width:140px;height:140px;border-radius:6px}
.qr-dropdown #qr_canvas canvas{width:140px;height:140px;border-radius:6px}
.qr-label{text-align:center;font-size:.68em;color:var(--muted);margin:6px 0 0}
.toast{position:fixed;bottom:80px;left:50%;transform:translateX(-50%);background:#333;color:#fff;padding:10px 22px;border-radius:8px;font-size:.82em;z-index:999;opacity:0;transition:opacity .3s;pointer-events:none}
.toast.show{opacity:1}
.capture-clean .toast{display:none!important}
.back-top{position:fixed;right:18px;bottom:22px;width:42px;height:42px;border-radius:50%;border:1px solid rgba(233,69,96,.25);background:#fff;color:var(--accent);box-shadow:0 8px 24px rgba(0,0,0,.14);cursor:pointer;font-weight:800;z-index:900;opacity:0;pointer-events:none;transform:translateY(8px);transition:opacity .2s,transform .2s,background .2s}
.back-top.show{opacity:1;pointer-events:auto;transform:translateY(0)}
.back-top:hover{background:var(--accent);color:#fff}
@media(prefers-reduced-motion:reduce){
  *,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;scroll-behavior:auto!important;transition-duration:.01ms!important}
}
</style>
</head>
<body>
<div class="container">
<header>
<h1>🎲 爱玩桌游 <span style="font-weight:400;font-size:.7em;color:var(--muted);-webkit-text-fill-color:var(--muted)">众筹资讯</span></h1>
<p>新物集 · 摩点 · Kickstarter · Gamefound ｜ 爱玩桌游club</p>
<div class="search-wrap" id="search_wrap">
  <div class="search-box">
    <input id="site_search" class="search-input" type="search" placeholder="搜索项目，或点右侧添加项目" autocomplete="off" oninput="onSearch(this.value)" onfocus="onSearch(this.value)" onkeydown="searchKey(event)">
    <span class="search-icon">⌕</span>
    <div id="search_results" class="search-results"></div>
  </div>
  <button type="button" class="add-game-btn" id="add_game_btn" onclick="handleAddProject()" title="添加项目">+ 添加项目</button>
</div>
</header>
<div class="tab-bar" role="tablist" aria-label="资讯分类">
<button type="button" class="tab-btn active" role="tab" aria-selected="true" aria-controls="tn" onclick="st('n')">📰 每日资讯</button>
<button type="button" class="tab-btn" role="tab" aria-selected="false" aria-controls="td" onclick="st('d')">🇨🇳 国内</button>
<button type="button" class="tab-btn" role="tab" aria-selected="false" aria-controls="to" onclick="st('o')">🌍 海外</button>
</div>
<div id="tn" class="tab-content active" role="tabpanel"><div class="daily-news-page" id="tn_content"></div></div>
<div id="td" class="tab-content" role="tabpanel" hidden></div>
<div id="to" class="tab-content" role="tabpanel" hidden></div>
<footer>
<p>数据来源：新物集 · 摩点 · Kickstarter · Gamefound</p>
<p>由小一自动整理 🤖 · <a href="https://aiwanlands.com">爱玩桌游club</a> · <button type="button" class="feedback-link" onclick="openFeedbackModal()">意见反馈</button></p>
<div class="footer-qr">
  <div id="qr_canvas"></div>
  <p class="qr-label">扫码访问 aiwanlands.com</p>
</div>
<div class="share-bar">
  <button type="button" class="share-btn" onclick="doShare()">📤 生成分享截图</button>
</div>
</footer>
</div>
<button type="button" class="back-top" id="back_top" onclick="scrollTopPage()" aria-label="回到页首">↑</button>
<div id="feedback_modal" class="modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="feedback_modal_title" onclick="closeFeedbackModal()">
  <div class="modal-card" onclick="event.stopPropagation()">
    <div class="modal-head">
      <h2 id="feedback_modal_title">意见反馈</h2>
      <button type="button" class="modal-close" onclick="closeFeedbackModal()">×</button>
    </div>
    <div class="form-grid">
      <label>建议内容<textarea id="feedback_text" class="feedback-textarea" placeholder="想看哪些项目、榜单或功能？"></textarea></label>
      <label>联系方式，可不填<input id="feedback_contact" class="feedback-input" placeholder="微信 / 邮箱 / 其他"></label>
      <button type="button" class="feedback-submit" style="height:40px" onclick="submitFeedback()">提交建议</button>
    </div>
  </div>
</div>
<div id="rank_modal" class="modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="rank_modal_title" onclick="closeRankModal()">
  <div class="modal-card" onclick="event.stopPropagation()">
    <div class="modal-head">
      <h2 id="rank_modal_title">详细榜单</h2>
      <button type="button" class="modal-close" onclick="closeRankModal()">返回</button>
    </div>
    <div id="rank_modal_body"></div>
  </div>
</div>
<div id="share_modal" class="modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="share_modal_title" onclick="closeShareModal()">
  <div class="modal-card share-modal-card" onclick="event.stopPropagation()">
    <div class="modal-head">
      <h2 id="share_modal_title">分享截图</h2>
      <button type="button" class="modal-close" onclick="closeShareModal()">关闭</button>
    </div>
    <p id="share_hint" class="share-hint">正在生成...</p>
    <div id="share_preview" class="share-preview-box"></div>
    <div id="share_actions" class="share-modal-actions"></div>
  </div>
</div>
