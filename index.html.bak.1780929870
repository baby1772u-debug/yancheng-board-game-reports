function escAttr(v){
  return String(v||'').replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}
function escHtml(v){
  return String(v||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}
function stripHtml(v){
  return String(v||'').replace(/<[^>]*>/g,'').replace(/\s+/g,' ').trim();
}
function cleanDisplayName(v){
  return stripHtml(v).replace(/[\u{1F300}-\u{1FAFF}\u{2600}-\u{27BF}]/gu,'').replace(/[\uFE0E\uFE0F]/g,'').replace(/[《》]/g,'').replace(/\s+/g,' ').trim();
}
function titleParts(it){
  var raw=String(it.t||it.n||'项目');
  var en=(raw.match(/<span class="en">([\s\S]*?)<\/span>/)||[])[1]||'';
  var cn=(raw.match(/<span class="cn">([\s\S]*?)<\/span>/)||[])[1]||'';
  var rawMain=raw.replace(/<span class="cn">[\s\S]*?<\/span>/g,'');
  var main=cleanDisplayName(en||rawMain);
  var sub=cn?cleanDisplayName(cn):'';
  if(!en&&it.n&&main.length>18)main=cleanDisplayName(it.n);
  return {main:main||cleanDisplayName(it.n)||'项目',sub:sub,foreign:!!en};
}
function titleHtml(it){
  var p=titleParts(it);
  if(!p.sub)return escHtml(p.main);
  if(p.foreign)return escHtml(p.main)+'<span class="cn"> / '+escHtml(p.sub)+'</span>';
  return escHtml(p.main);
}
function dailyTitleHtml(it){
  var p=titleParts(it);
  if(!p.sub)return escHtml(p.main);
  if(p.foreign)return escHtml(p.main)+' <span class="dcs-inline">/ '+escHtml(p.sub)+'</span>';
  return escHtml(p.main);
}
function imgTag(src,label){
  if(!src)return '';
  return '<img src="'+escAttr(src)+'" alt="'+escAttr(label||'项目封面')+'" loading="eager" decoding="async" onerror="this.style.display=\'none\'">';
}
function extLink(url,content,cls){
  return '<a class="'+escAttr(cls||'cl')+'" href="'+escAttr(url)+'" target="_blank" rel="noopener noreferrer">'+content+'</a>';
}
function st(t){
  var idx={n:0,d:1,o:2}[t]||0;
  currentTab=t;
  document.querySelectorAll('.tab-content').forEach(function(e,i){
    var on=i===idx;
    e.classList.toggle('active',on);
    e.hidden=!on;
  });
  document.querySelectorAll('.tab-btn').forEach(function(b,i){
    var on=i===idx;
    b.classList.toggle('active',on);
    b.setAttribute('aria-selected',on?'true':'false');
  });
  if(t==='n')rn();
  if(t==='d')renderMarketTab('td',[].concat(DL).concat(DU),DP,DE,DTE,'🇨🇳 国内');
  if(t==='o')renderMarketTab('to',[].concat(OL).concat(OU),OP,OL.filter(function(it){var ed=pd(it.ed);return ed&&ed<new Date()}),OTE,'🌍 海外');
}

function gi(nm){
  if(!nm)return '';
  var k='im_'+nm.replace(/ /g,'_').replace(/:/g,'').replace(/·/g,'').replace(/！/g,'').replace(/？/g,'');
  return window[k]||'';
}
function dt(){var d=new Date();return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0')}
function pd(s){if(!s)return null;var d=new Date(s);return isNaN(d.getTime())?null:d}
function dd(a,b){return Math.round((b-a)/86400000)}
function cds(t,n){if(!t)return'';var d=t-n;if(d<=0)return'已开始';var x=Math.floor(d/86400000),h=Math.floor((d%86400000)/3600000);return x>0?x+'天'+h+'小时':h+'小时'}
function tdy(d){var n=new Date();return d&&d.getFullYear()===n.getFullYear()&&d.getMonth()===n.getMonth()&&d.getDate()===n.getDate()}
function keyOf(it){
  return String(it.n||it.t||'project').replace(/[^\w\u4e00-\u9fff-]+/g,'_');
}
function numFromText(s){
  var m=String(s||'').match(/([\d,.]+)\s*(万|k|K)?/);
  if(!m)return 0;
  var v=parseFloat(m[1].replace(/,/g,''));
  if(!isFinite(v))return 0;
  if(m[2]==='万')v*=10000;
  if(m[2]&&m[2].toLowerCase()==='k')v*=1000;
  return Math.round(v);
}
function amountOf(it){
  var txt=[].concat(it.tl||[],it.m||'',it.m2||'',it.pr||'').join(' ');
  var ms=txt.match(/[¥$€£]\s*([\d,]+)/g)||[];
  if(!ms.length)return 0;
  return Math.max.apply(null,ms.map(function(x){return numFromText(x)}));
}
function backersOf(it){
  var txt=[].concat(it.tl||[],it.m||'',it.m2||'').join(' ');
  var m=txt.match(/(?:支持者|已购)\s*([\d,]+)/)||txt.match(/([\d,]+)\s*人(?:支持|已购)/);
  return m?numFromText(m[1]):0;
}
function followersOf(it){
  var txt=[].concat(it.tl||[],it.m||'',it.m2||'').join(' ');
  var m=txt.match(/([\d,.]+)\s*(万|k|K)?\s*(?:人)?(?:关注|预约|感兴趣)/);
  return m?numFromText(m[1]+(m[2]||'')):0;
}
function launchDateRaw(it){return it.sd||LAUNCH_DATES[it.n]||''}
function startDateOf(it){var raw=launchDateRaw(it);return pd(raw?String(raw).replace('T',' '):null)}
function endDateOf(it){return pd(it.ed)}
function isTodayStart(it){var sd=startDateOf(it);return !!(sd&&tdy(sd))}
function isFunding(it,n){
  var ed=endDateOf(it),sd=startDateOf(it);
  if(it.ta&&it.ta.indexOf('l')>=0&&(!ed||ed>n))return true;
  return !!(sd&&sd<=n&&(!ed||ed>n));
}
function isUpcoming(it,n){
  var sd=startDateOf(it);
  if(sd)return sd>n;
  return !!(it.ta&&it.ta.indexOf('u')>=0&&!(it.ta&&it.ta.indexOf('l')>=0));
}
function isExpectation(it,n){
  var sd=startDateOf(it);
  if(sd)return sd>n;
  return !isFunding(it,n)&&followersOf(it)>0;
}
function isEndedProject(it,n){
  var ed=endDateOf(it);
  return !!((ed&&ed<n)||/已结束|众筹成功/.test([it.m].concat(it.tl||[]).join(' ')));
}
function cleanTitle(it){return titleParts(it).main}
function shortTitle(it){return cleanDisplayName(it.n||cleanTitle(it)||'项目')}
function sortMetric(it,mode){
  if(mode==='amount')return amountOf(it);
  if(mode==='backers')return backersOf(it)||followersOf(it);
  if(mode==='latest'){
    var sd=startDateOf(it);
    return (sd||new Date(0)).getTime();
  }
  return hotScore(it);
}
function hotScore(it){
  var score=amountOf(it)/1000+backersOf(it)*2+followersOf(it);
  if(it.ta&&it.ta.indexOf('h')>=0)score+=3000;
  score+=projectHeat(keyOf(it))*18;
  if(isTodayStart(it))score+=1000000;
  var ed=endDateOf(it),n=new Date();
  if(ed&&ed>n){var left=(ed-n)/86400000;if(left<=3)score+=9000;else if(left<=10)score+=3000}
  var sd=startDateOf(it);
  if(sd&&sd>n){var until=(sd-n)/86400000;if(until<=3)score+=6000}
  return score;
}
function sortedItems(items,mode){
  var arr=items.slice(0),n=new Date();
  arr.sort(function(a,b){
    if(isTodayStart(a)!==isTodayStart(b))return isTodayStart(b)-isTodayStart(a);
    if(mode==='latest'){
      var av=sortMetric(a,mode),bv=sortMetric(b,mode);
      return bv-av;
    }
    return sortMetric(b,mode)-sortMetric(a,mode);
  });
  return arr;
}
var DESC={
  '赛博朋克红':'经典赛博朋克 TRPG 的简体中文版，强调高风险任务、角色成长和浓烈的近未来叙事，适合喜欢跑团和世界观沉浸的玩家。',
  '阿克莱特':'重度经济策略游戏，玩家经营棉纺工厂，从机器升级、工人管理、运输渠道到市场需求都要精打细算。它的魅力在于“工业革命不是背景板，而是每一轮现金流和扩张决策都在推着你往前走”。',
  '幻色秘典':'卡牌对战项目，围绕套牌构筑和即时对抗展开，体量轻巧，适合想要快速开局又保留组合深度的玩家。',
  '翠屿秘境':'米宝海豚引进的典藏版项目，主打岛屿探索与精致美术，适合关注桌面呈现和家庭向冒险氛围的玩家。',
  '遥远之地':'《遥远之地》的扩展与补档项目，核心看点是轻量规则下的地图探索、资源取舍和清新的奇幻美术，适合想补全系列或寻找轻策略体验的玩家。',
  'Crash第二季':'DBG 对战续作，围绕牌组成长、节奏压制和角色能力展开，适合喜欢快节奏对抗和组合爆发的玩家。',
  '雾雨世界':'长篇冒险 PVE 剧情桌游，卖点是章节推进、角色养成与合作挑战，适合偏爱叙事战役和沉浸探索的玩家。',
  '三国走走棋':'三国题材战棋扩展，强调棋盘走位、武将能力和对局博弈，适合已经喜欢本体并希望增加阵容变化的玩家。',
  '马拉开波海盗':'《马拉开波》扩展项目，把航海路线、行动节奏和地图变化继续拉开，适合喜欢中重德式规划和多路线得分的玩家。',
  'Beast Ashfall':'不对称对抗系列续作，一方操控巨兽潜行猎杀，另一方协作追踪围捕，适合喜欢心理博弈和强互动的玩家。',
  'Stonesaga':'开放式冒险与部落成长题材，强调长期战役、探索和制作系统，适合喜欢叙事推进与持续养成的玩家。',
  'Nemesis Legacy':'太空生存恐怖传承作品，保留半合作、危机管理和未知威胁的张力，适合喜欢剧情战役和强代入感的玩家。',
  'Concordia SE':'经典经济路线建设游戏的特别版，核心是手牌管理、地图扩张和资源节奏，适合偏爱优雅德式系统的玩家。'
};
function descOf(it){
  if(DESC[it.n])return DESC[it.n];
  var title=cleanTitle(it),bits=[];
  if(it.m)bits.push(stripHtml(it.m));
  if(it.pr)bits.push(stripHtml(it.pr));
  var base=bits.join(' · ');
  if(!base)base='当前众筹信息持续更新中';
  return title+'：'+base+'。适合关注题材、美术和众筹节点后再决定是否跟进的玩家。';
}
function progressInfo(it){
  var n=new Date(),sd=startDateOf(it),ed=endDateOf(it);
  if(isFunding(it,n)){
    var pct=Math.max(0,Math.min(toFinite(it.pg)||0,9999));
    if(!pct&&it.m2){
      var m=String(it.m2).match(/完成率\s*([\d.]+)%/);
      if(m)pct=parseFloat(m[1]);
    }
    var bar=Math.max(6,Math.min(pct,100));
    return {bar:bar,label:pct?('完成率 '+Math.round(pct)+'%'):'众筹中'};
  }
  if(sd&&sd>n){
    var days=Math.max(0,Math.ceil((sd-n)/86400000));
    var bar=Math.max(6,Math.min(100,100-days*10));
    return {bar:bar,label:days===0?'今日上线':days+'天后上线'};
  }
  if(ed&&ed<n)return {bar:100,label:'已结束'};
  return null;
}
function toFinite(v){var n=parseFloat(v);return isFinite(n)?n:0}
var RECENT_DELTA={
  '赛博朋克红':{amount:4352,people:2},
  '阿克莱特':{amount:14726,people:38},
  '幻色秘典':{amount:808,people:2},
  'Stonesaga':{amount:219,people:1},
  'Beast Ashfall':{amount:0,people:0},
  'Concordia SE':{followers:4969},
  'TEND':{followers:0}
};
function deltaOf(it,mode){
  var d=RECENT_DELTA[it.n]||{};
  if(mode==='expect')return {followers:d.followers||0};
  return {amount:d.amount||0,people:d.people||0};
}
function moneyLabel(n){
  n=Number(n)||0;
  if(!n)return '金额待同步';
  return '+¥'+n.toLocaleString('zh-CN');
}
function peopleLabel(n){
  n=Number(n)||0;
  if(!n)return '人数待同步';
  return '+'+n.toLocaleString('zh-CN')+'人';
}
function rulesBlock(it){
  if(it.rules&&it.rules.length){
    return '<div class="rules-slot"><strong>规则讲解</strong><br>'+it.rules.map(function(r){return '<a href="'+escAttr(r.url)+'" target="_blank" rel="noopener noreferrer">'+escHtml(r.title||'查看讲解')+'</a>'}).join(' · ')+'</div>';
  }
  return '';
}
function readStore(key,fallback){
  try{return JSON.parse(localStorage.getItem(key)||JSON.stringify(fallback))}
  catch(e){return fallback}
}
function writeStore(key,value){
  try{localStorage.setItem(key,JSON.stringify(value))}catch(e){}
}
function heatStore(){return readStore(HEAT_KEY,{})}
function projectHeat(key){
  var row=heatStore()[key]||{};
  return Math.max(0,Math.round(row.heat||0));
}
function todayKey(){
  var d=new Date();
  return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
}
function heatBadge(key){
  var heat=projectHeat(key);
  if(heat<HEAT_RECOMMEND_THRESHOLD)return '';
  return '<span class="heat-badge" data-heat-key="'+escAttr(key)+'">热度 '+heat+'</span>';
}
function engagementInner(key){
  var locks=readStore(VOTE_LOCK_KEY,{}),last=locks[key]||{},chosen=last.date===todayKey()?last.dir:'';
  if(chosen==='up')return '<button type="button" class="vote-btn active" title="已点赞" aria-label="已点赞" onclick="voteProject(event,\''+escAttr(key)+'\',\'up\')">❤</button>';
  if(chosen==='down')return '<button type="button" class="vote-btn down active" title="已点踩" aria-label="已点踩" onclick="voteProject(event,\''+escAttr(key)+'\',\'down\')">👎</button>';
  return '<button type="button" class="vote-btn" title="点赞" aria-label="点赞" onclick="voteProject(event,\''+escAttr(key)+'\',\'up\')">❤</button><button type="button" class="vote-btn down" title="点踩" aria-label="点踩" onclick="voteProject(event,\''+escAttr(key)+'\',\'down\')">👎</button>';
}
function engagementBlock(it){
  var key=keyOf(it);
  return '<div class="engagement-row" data-engagement-key="'+escAttr(key)+'">'+engagementInner(key)+'</div>';
}
function renderProjectEngagement(key){
  document.querySelectorAll('[data-engagement-key="'+CSS.escape(key)+'"]').forEach(function(el){el.innerHTML=engagementInner(key)});
  document.querySelectorAll('[data-heat-slot="'+CSS.escape(key)+'"]').forEach(function(el){el.innerHTML=heatBadge(key)});
}
function bumpHeat(key,delta,field){
  var data=heatStore(),row=data[key]||{heat:0};
  row.heat=Math.max(0,(row.heat||0)+delta);
  if(field)row[field]=(row[field]||0)+1;
  row.updated_at=new Date().toISOString();
  data[key]=row;
  writeStore(HEAT_KEY,data);
  renderProjectEngagement(key);
}
function voteProject(event,key,dir){
  event.preventDefault();
  event.stopPropagation();
  var locks=readStore(VOTE_LOCK_KEY,{}),day=todayKey(),last=locks[key]||{};
  if(last.date===day){toast('今天已记录，明天可以重新选择');return}
  locks[key]={date:day,time:Date.now(),dir:dir};
  writeStore(VOTE_LOCK_KEY,locks);
  bumpHeat(key,dir==='up'?8:-3,dir==='up'?'likes':'dislikes');
  toast(dir==='up'?'已记录喜欢':'已记录反馈');
}
function recordProjectEvent(key,type,seconds){
  if(!key)return;
  if(type==='jump')bumpHeat(key,5,'jumps');
  else if(type==='view')bumpHeat(key,1,'views');
  else if(type==='dwell')bumpHeat(key,Math.min(8,Math.max(1,Math.round((seconds||0)/8))),'dwell');
}
function recordViewDuration(key){
  var start=viewStartMap[key];
  if(!start)return;
  delete viewStartMap[key];
  var seconds=(Date.now()-start)/1000;
  if(seconds>=5)recordProjectEvent(key,'dwell',seconds);
}
function platformText(it){
  var p=stripHtml(it.pl||'').replace(/^[^\u4e00-\u9fffA-Za-z0-9]+/,'').trim();
  return p||stripHtml(it.m||'').split('·')[0].trim()||'平台';
}
function agencyText(it){
  var p=titleParts(it);
  if(p.foreign)return '';
  var candidates=[];
  if(p.sub)candidates=candidates.concat(p.sub.split('·').map(function(x){return x.trim()}));
  candidates=candidates.concat(stripHtml(it.m||'').split('·').map(function(x){return x.trim()}));
  candidates=candidates.filter(function(x){
    return x&&x!==platformText(it)&&!/开售|预约|截止|剩|已结束|众筹|完成率|已购|支持者|目标|今天|小时|日前|天后/.test(x);
  });
  var hit=candidates.filter(function(x){
    return /工作室|桌游|兵棋|海豚|企鹅|圣剑|夜航船|游人|满意|向量|原石|树豆|摇摆客|乘风|山海|浩瀚|小狮子|一刻馆|帝企鹅/.test(x);
  })[0];
  return hit||'';
}
function platformWithAgency(it){
  var parts=[platformText(it)],agency=agencyText(it);
  if(agency&&parts.indexOf(agency)<0)parts.push(agency);
  return parts.join(' · ');
}
function dateOnly(d){return d?d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0'):''}
function monthDay(d){return d?(String(d.getMonth()+1)+'月'+String(d.getDate())+'日'):''}
function cardMeta(it,n){
  var p=platformWithAgency(it),sd=startDateOf(it),ed=endDateOf(it),base=stripHtml(it.m||'');
  if(isFunding(it,n)&&ed)return p+' · 截止日期 '+dateOnly(ed);
  if(sd&&sd>n){
    var f=followersOf(it);
    return p+' · '+monthDay(sd)+'开售'+(f?' · '+Number(f).toLocaleString('zh-CN')+'人预约':'');
  }
  if(isEndedProject(it,n))return p+' · 已结束'+(ed?' '+dateOnly(ed):'');
  if(base&&base.indexOf(p)<0)return p+' · '+cleanDisplayName(base.replace(/^.*?·\s*/,''));
  return cleanDisplayName(base)||p;
}
function cleanCardLine(v){
  return stripHtml(v||'').replace(/[·\s]*剩\d+天(?:\d+小时)?(?:截止)?/g,'').trim();
}
function rc(it){
  var im='',uv=gi(it.n);
  if(uv){im=imgTag(uv,it.n)}
  else if(it.i){im=imgTag(it.i,it.n)}
  var bt='',bx='',n=new Date(),ed=pd(it.ed),sd=startDateOf(it),endedStatus=isEndedProject(it,new Date());
  if(it.ta)it.ta.forEach(function(c,j){
    var tag=it.tl[j]||'';
    if(endedStatus&&(c==='l'||/众筹中/.test(tag)))return;
    bt+='<span class="ctg '+c+'">'+tag+'</span>';
  });
  if(it.p)bx+='<span class="p2 '+it.p+'">'+it.pl+'</span>';
  if(it.p2)bx+='<span class="p2 '+it.p2+'">'+it.pl2+'</span>';
  var cd='';
  if(ed&&ed>n&&!isFunding(it,n)){var d2=dd(n,ed);cd='<span style="color:'+(d2<=1?'var(--accent2)':'var(--muted)')+';font-size:.75em;font-weight:'+(d2<=1?'600':'400')+'">⏰ 剩'+cds(ed,n)+'</span>'}
  if(sd&&sd>n)cd='<span style="color:var(--gold);font-weight:600;font-size:.75em">🔥 '+cds(sd,n)+'后开售</span>';
  if(isTodayStart(it))bt+='<span class="today-badge">今日开始</span>';
  var pi=progressInfo(it);
  var pb=pi?'<div class="progress-row"><div class="pb"><div class="pbf" style="width:'+Math.min(pi.bar,100)+'%"></div></div><span class="progress-text">'+escHtml(pi.label)+'</span></div>':'';
  var key=keyOf(it);
  var cls='card';
  if(isFunding(it,n))cls+=' funding-card';
  else if(isUpcoming(it,n))cls+=' upcoming-card';
  else if(isEndedProject(it,n))cls+=' ended-card';
  var m2=cleanCardLine(it.m2);
  return '<article class="'+cls+'" data-project-key="'+escAttr(key)+'"><button type="button" class="cr" onclick="toggleCard(this)"><div class="ciw">'+im+'</div><div class="cif"><div class="card-title-line"><div class="ct title-main">'+titleHtml(it)+'</div><span data-heat-slot="'+escAttr(key)+'">'+heatBadge(key)+'</span></div><div class="cm">'+escHtml(cardMeta(it,n))+'</div><div>'+bx+' '+bt+'</div>'+(m2?'<div class="cm" style="margin-top:2px">'+escHtml(m2)+'</div>':'')+(it.pr?'<div class="pr" style="margin-top:2px">'+escHtml(it.pr)+'</div>':'')+cd+pb+'</div></button><div class="card-detail"><div class="detail-copy">'+escHtml(descOf(it))+'</div>'+rulesBlock(it)+'<div class="detail-actions"><a class="detail-link" href="'+escAttr(it.l)+'" target="_blank" rel="noopener noreferrer" onclick="recordProjectEvent(\''+escAttr(key)+'\',\'jump\')">查看众筹页面</a>'+engagementBlock(it)+'</div></div></article>';
}
function rp(items){
  var h='<div class="g3">';
  items.forEach(function(p){
    var im='';
    if(p.hi&&gi(p.ni)){im=imgTag(gi(p.ni),p.n)}
    h+='<div class="mc" data-project-key="'+escAttr(keyOf(p))+'">'+extLink(p.l,'<div class="mi">'+im+'</div><div class="mn">'+escHtml(p.n)+'</div><div class="mm">'+escHtml(p.m||'')+'</div>')+'</div>';
  });
  return h+'</div>';
}
function rtl(events){
  var n=dt(),h='<div class="tl">';
  events.slice().sort(function(a,b){return String(b.d).localeCompare(String(a.d))}).forEach(function(e){
    var cls=e.d<n?'tli dn':e.d===n?'tli td':'tli';
    var lb=e.d===n?'📅 今天':e.d<n?'📅 '+e.d+' ✅':'📅 '+e.d;
    h+='<div class="'+cls+'"><div class="td">'+lb+'</div><div class="te">'+e.e+'</div></div>';
  });
  return h+'</div>';
}
function sectionState(key){
  if(!uiState[key])uiState[key]={sort:'hot',open:false};
  return uiState[key];
}
function sortControls(key){
  var stt=sectionState(key),opts=[['hot','推荐'],['latest','最新'],['amount','金额'],['backers','人数']];
  return '<div class="section-tools">'+opts.map(function(o){
    return '<button type="button" class="sort-btn '+(stt.sort===o[0]?'active':'')+'" onclick="setSort(\''+key+'\',\''+o[0]+'\')">'+o[1]+'</button>';
  }).join('')+'</div>';
}
function renderListSection(key,icon,title,items,limit){
  var stt=sectionState(key),sorted=sortedItems(items,stt.sort),shown=stt.open?sorted:sorted.slice(0,limit);
  var h='<div class="sec"><span>'+icon+'</span><h2>'+title+'</h2><span class="bc">'+items.length+'个项目</span></div>'+sortControls(key)+shown.map(rc).join('');
  if(sorted.length>limit)h+='<button type="button" class="more-btn" onclick="toggleMore(\''+key+'\')">'+(stt.open?'收起':'查看更多 '+(sorted.length-limit)+' 个')+'</button>';
  return h;
}
function renderPreviewSection(key,items){
  var stt=sectionState(key),sorted=sortedItems(items,stt.sort),shown=stt.open?sorted:sorted.slice(0,6);
  var h='<div class="sec"><span>📋</span><h2>预告项目</h2><span class="bc">共'+items.length+'个</span></div>'+sortControls(key)+rp(shown);
  if(sorted.length>6)h+='<button type="button" class="more-btn" onclick="toggleMore(\''+key+'\')">'+(stt.open?'收起':'查看更多 '+(sorted.length-6)+' 个')+'</button>';
  return h;
}
function renderMarketTab(id,items,pp,ended,te,lb){
  var n=new Date(),td=dt();
  var todayEnd=[],nowFunding=[],comingSoon=[];
  items.forEach(function(it){
    var ed=pd(it.ed),sd=startDateOf(it);
    if(ed&&tdy(ed)){todayEnd.push(it);return}
    if(isFunding(it,n)){nowFunding.push(it);return}
    if(isUpcoming(it,n)){comingSoon.push(it)}
  });
  todayEnd.sort(function(a,b){return(pd(a.ed)||0)-(pd(b.ed)||0)});
  
  var h='';
  if(todayEnd.length>0)h+='<div class="sec"><span>⏰</span><h2>今天截止</h2><span class="bc">倒计时</span></div>'+todayEnd.map(rc).join('');
  h+=renderListSection(id+'-active','🎯','正在众筹',nowFunding,5);
  if(comingSoon.length>0)h+=renderListSection(id+'-upcoming','🔥','即将上线',comingSoon,3);
  if(ended.length>0)h+=renderListSection(id+'-ended','✅','已结束',ended,3);
  h+=renderPreviewSection(id+'-preview',pp);
  h+='<div class="sec"><span>⏳</span><h2>关键时间节点</h2></div>'+rtl(te);
  document.getElementById(id).innerHTML=h;
}

function setSort(key,sort){sectionState(key).sort=sort;st(currentTab)}
function toggleMore(key){sectionState(key).open=!sectionState(key).open;st(currentTab)}
function toggleCard(btn){
  var card=btn.closest('.card');
  if(!card)return;
  card.classList.toggle('open');
  var key=card.getAttribute('data-project-key');
  if(card.classList.contains('open')){
    viewStartMap[key]=Date.now();
    recordProjectEvent(key,'view');
  }else{
    recordViewDuration(key);
  }
}

function rn(){
  var td=dt(), n=new Date();
  var h='<div class="sec"><span>📰</span><h2>每日资讯 · 汇总</h2><span class="bc">'+td+'</span></div><div class="daily-stack">';
  h+=buildDailyV2(DL,DU,DE,'🇨🇳 国内',td,n);
  h+=buildDailyV2(OL,OU,OL.filter(function(it){var ed=pd(it.ed);return ed&&ed<n;}),'🌍 海外',td,n);
  h+='</div>';
  document.getElementById('tn_content').innerHTML=h;
}

function buildDailyV2(funding,upcoming,ended,lb,td,n){
  var sections=[], im='';
  
  var justLaunched = funding.concat(upcoming).filter(function(it){
    var sd=startDateOf(it);
    return sd&&sd<=n;
  });
  justLaunched.sort(function(a,b){
    return startDateOf(b)-startDateOf(a);
  });
  if(justLaunched.length>0){
    var it=justLaunched[0],sd=pd(it.sd);
    var days=Math.round((n-sd)/86400000);
    var label=days===0?'今天上线':days+'天前上线';
    im=imgTag(gi(it.n),it.n);
    sections.push({title:'最近上线',kind:'funding',item:it,label:label,sub:label,img:im});
  }
  
  var comingUp = upcoming.filter(function(it){
    var sd=startDateOf(it);
    return sd&&sd>n;
  });
  comingUp.sort(function(a,b){return startDateOf(a)-startDateOf(b)});
  if(comingUp.length>0){
    var it=comingUp[0],sd=pd(it.sd);
    var d2=Math.round((sd-n)/86400000);
    var label=d2+'天后开售';
    im=imgTag(gi(it.n),it.n);
    sections.push({title:'即将上线',kind:'upcoming',item:it,label:label,sub:cds(sd,n)+'后开售',img:im});
  }
  
  var endingSoon = funding.filter(function(it){
    var ed=pd(it.ed);
    return ed&&ed>n;
  });
  endingSoon.sort(function(a,b){return pd(a.ed)-pd(b.ed)});
  if(endingSoon.length>0){
    var it=endingSoon[0],ed=pd(it.ed);
    var d2=Math.round((ed-n)/86400000);
    var label=d2===0?'今天截止':d2+'天后截止';
    im=imgTag(gi(it.n),it.n);
    sections.push({title:'即将结束',kind:'funding',item:it,label:label,sub:cds(ed,n)+'后截止',img:im});
  }

  var h='<div class="daily"><div class="dh">📰 每日资讯 <span class="sub">'+lb+' · '+td+'</span></div><div class="daily-cards">';
  sections.forEach(function(s){
    var it=s.item;
    var tab=rankKeyFromLabel(lb)==='domestic'?'d':'o';
    h+='<button type="button" class="daily-card" onclick="focusProject(\''+tab+'\',\''+escAttr(keyOf(it))+'\')"><div class="dciw">'+s.img+'<div class="dciw-overlay"></div><span class="dciw-badge">'+s.title+'</span></div><div class="dct">'+dailyTitleHtml(it)+'</div><div class="dcm">'+escHtml(s.sub)+'</div><div class="dcv">'+escHtml(dailyMetricText(it,s.kind))+'</div></button>';
  });
  h+=dailyRankCard(funding,upcoming,n,lb);
  h+='</div></div>';
  return h;
}

function rankKeyFromLabel(lb){return lb.indexOf('国内')>=0?'domestic':'overseas'}
function rankValue(it,mode){
  if(mode==='amount')return amountOf(it);
  return backersOf(it)||followersOf(it);
}
function rankValueText(it,mode){
  if(mode==='amount')return amountTextOf(it);
  var v=backersOf(it)||followersOf(it);
  return v?(v+'人'):'人数待同步';
}
function amountTextOf(it){
  var txt=((it.tl||[]).filter(function(x){return /[¥$€£]/.test(x)})[0]||'').replace(/^[^\d¥$€£]+/,'').trim();
  return txt||'金额待同步';
}
function dailyMetricText(it,kind){
  if(kind==='upcoming'){
    var f=followersOf(it);
    return f?'关注 '+f.toLocaleString('zh-CN')+'人':'关注待同步';
  }
  return '当前 '+amountTextOf(it);
}
function dailyRankCard(funding,upcoming,n,lb){
  var key=rankKeyFromLabel(lb),mode=rankMode[key]||'amount';
  var live=funding.filter(function(it){return isFunding(it,n)});
  var expect=upcoming.filter(function(it){return isExpectation(it,n)});
  var pool=mode==='amount'?(live.length>=3?live:funding):live.concat(expect);
  var sorted=pool.slice().filter(function(it){
    var v=rankValue(it,mode);
    if(mode==='people')return v>0;
    return true;
  }).sort(function(a,b){return rankValue(b,mode)-rankValue(a,mode)});

  var displayCount=8;
  var topItems=sorted.slice(0,displayCount);
  var max=Math.max.apply(null,topItems.map(function(it){return rankValue(it,mode)}).concat([1]));

  function itemHtml(it,i){
    var value=rankValue(it,mode);
    var pct=Math.max(5,Math.min(100,value/max*100));
    return '<div class="rank-scroll-item"><span class="rank-scroll-no">'+(i+1)+'.</span><span class="rank-scroll-name">'+escHtml(shortTitle(it))+'</span><span class="rank-scroll-value">'+escHtml(rankValueText(it,mode))+'</span><span class="rank-scroll-bar"><span class="rank-scroll-bar-fill" style="width:'+pct+'%"></span></span></div>';
  }

  var itemsHtml=topItems.length?topItems.map(itemHtml).join(''):'<div class="rank-scroll-empty">暂无可展示项目</div>';
  return '<div id="daily_rank_'+key+'" class="rank-scroll-wrap" role="button" tabindex="0" onclick="openRankModal(\''+key+'\')" onkeydown="rankCardKey(event,\''+key+'\')"><div class="rank-scroll-head"><div class="rank-scroll-title"><span>🏆 榜单</span></div><div class="rank-toggle"><button type="button" class="'+(mode==='amount'?'active':'')+'" onclick="setRankMode(event,\''+key+'\',\'amount\')">金额</button><button type="button" class="'+(mode==='people'?'active':'')+'" onclick="setRankMode(event,\''+key+'\',\'people\')">人数</button></div></div><div class="rank-scroll-inner">'+itemsHtml+'</div></div>';
}

function dailyRankSource(key){
  return key==='domestic'
    ? {funding:DL,upcoming:DU,label:'🇨🇳 国内'}
    : {funding:OL,upcoming:OU,label:'🌍 海外'};
}
function setRankMode(event,key,mode){
  event.stopPropagation();
  rankMode[key]=mode;
  var src=dailyRankSource(key),card=document.getElementById('daily_rank_'+key);
  if(card)card.outerHTML=dailyRankCard(src.funding,src.upcoming,new Date(),src.label);
}
function rankCardKey(event,key){
  if(event.key==='Enter'||event.key===' '){event.preventDefault();openRankModal(key)}
}
function rankData(key){
  var n=new Date();
  if(key==='domestic'){
    return {
      title:'国内详细榜单',
      funding:DL.concat(DU).filter(function(it){return isFunding(it,n)}),
      expect:DU.concat(DP).filter(function(it){return isExpectation(it,n)})
    };
  }
  return {
    title:'海外详细榜单',
    funding:OL.concat(OU).filter(function(it){return isFunding(it,n)}),
    expect:OU.concat(OP).filter(function(it){return isExpectation(it,n)})
  };
}
function rankModalItems(data,mode){
  var items=mode==='amount'?data.funding:data.funding.concat(data.expect);
  return items.slice().filter(function(it){return rankValue(it,mode)>0}).sort(function(a,b){return rankValue(b,mode)-rankValue(a,mode)});
}
function rankDeltaText(it,mode){
  var d=deltaOf(it,mode==='amount'?'amount':'expect');
  return mode==='amount'?(moneyLabel(d.amount)+' · '+peopleLabel(d.people)):(d.followers?peopleLabel(d.followers):'增长待同步');
}
function growthSeries(it,mode){
  var total=Math.max(rankValue(it,mode),1);
  var start=startDateOf(it)||new Date(Date.now()-13*86400000);
  var end=endDateOf(it);
  var stop=end&&end<new Date()?end:new Date();
  var days=Math.max(7,Math.min(14,Math.ceil((stop-start)/86400000)||7));
  var d=deltaOf(it,mode==='amount'?'amount':'expect');
  var recent=mode==='amount'?(d.amount||Math.round(total*.018)):(d.followers||d.people||Math.round(total*.025));
  var values=[],base=Math.max(1,total-Math.max(recent*6,total*.18));
  for(var i=0;i<days;i++){
    var t=days===1?1:i/(days-1);
    var eased=1-Math.pow(1-t,1.7);
    var wave=Math.sin(i*1.4)*0.025*total;
    var v=Math.round(base+(total-base)*eased+wave);
    if(i===days-1)v=total;
    values.push(Math.max(1,Math.min(total,v)));
  }
  return values;
}
function growthChartHtml(it,mode){
  var vals=growthSeries(it,mode),w=320,h=132,p=16,min=Math.min.apply(null,vals),max=Math.max.apply(null,vals);
  if(max===min){max=min+1}
  var pts=vals.map(function(v,i){
    var x=p+i*(w-p*2)/(vals.length-1),y=h-p-(v-min)*(h-p*2)/(max-min);
    return [Math.round(x),Math.round(y)];
  });
  var poly=pts.map(function(p){return p[0]+','+p[1]}).join(' ');
  var area=''+pts[0][0]+','+(h-p)+' '+poly+' '+pts[pts.length-1][0]+','+(h-p);
  return '<div class="growth-title">'+escHtml(cleanTitle(it)).slice(0,18)+'</div><svg class="growth-chart" viewBox="0 0 '+w+' '+h+'" role="img" aria-label="每日增长曲线"><polygon points="'+area+'" fill="rgba(233,69,96,.12)" stroke="none"></polygon><polyline points="'+poly+'" fill="none" stroke="#e94560" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"></polyline>'+pts.map(function(p){return '<circle cx="'+p[0]+'" cy="'+p[1]+'" r="3.2" fill="#d4a843"/>'}).join('')+'</svg><div class="growth-note">众筹期间每日增长曲线。当前用已同步数据生成趋势预览，接入每日抓取后会替换为真实每日记录。</div>';
}
function renderRankModal(){
  var data=rankData(rankModalState.key),mode=rankModalState.mode;
  var allItems=rankModalItems(data,mode);
  var items=rankModalState.showAll?allItems:allItems.slice(0,7);
  var selected=items.filter(function(it){return keyOf(it)===rankModalState.selected})[0];
  var max=Math.max.apply(null,allItems.map(function(it){return rankValue(it,mode)}).concat([1]));
  document.getElementById('rank_modal_title').textContent=data.title;
  var h='<div class="rank-modal-tools"><button type="button" class="'+(mode==='amount'?'active':'')+'" onclick="setRankModalMode(\'amount\')">金额</button><button type="button" class="'+(mode==='people'?'active':'')+'" onclick="setRankModalMode(\'people\')">人数</button></div>';
  if(!allItems.length){document.getElementById('rank_modal_body').innerHTML=h+'<div style="color:var(--muted);font-size:12px">暂无数据</div>';return}
  h+='<div class="rank-modal-list">'+items.map(function(it,i){
    var active=selected&&keyOf(it)===keyOf(selected);
    var pct=Math.max(6,Math.min(100,rankValue(it,mode)/max*100));
    return '<div class="rank-row '+(active?'open':'')+'"><button type="button" class="rank-item '+(active?'active':'')+'" onclick="selectRankProject(\''+escAttr(keyOf(it))+'\')"><div class="rank-row-main"><div class="rank-no">'+(i+1)+'</div><div class="rank-thumb">'+imgTag(gi(it.n),it.n)+'</div><div class="rank-row-copy"><div class="rank-name">'+escHtml(shortTitle(it))+'</div><div class="rank-meta">'+escHtml(rankValueText(it,mode))+' · 最近新增 '+escHtml(rankDeltaText(it,mode))+'</div><div class="rank-row-progress"><div class="mini-track"><div class="mini-fill" style="width:'+pct+'%"></div></div><span class="rank-meta">'+Math.round(pct)+'%</span></div></div></div></button><div class="rank-expand">'+(active?growthChartHtml(it,mode)+'<button type="button" class="rank-project-link" onclick="openRankProjectFromModal(event,\''+escAttr(keyOf(it))+'\')">查看项目</button>':'')+'</div></div>';
  }).join('')+'</div>';
  if(allItems.length>7)h+='<button type="button" class="rank-more" onclick="toggleRankMore()">'+(rankModalState.showAll?'收起榜单':'查看更多 '+(allItems.length-7)+' 个')+'</button>';
  document.getElementById('rank_modal_body').innerHTML=h;
}
function setRankModalMode(mode){
  rankModalState.mode=mode;
  rankModalState.selected='';
  rankModalState.showAll=false;
  renderRankModal();
}
function selectRankProject(projectKey){
  rankModalState.selected=rankModalState.selected===projectKey?'':projectKey;
  renderRankModal();
}
function toggleRankMore(){
  rankModalState.showAll=!rankModalState.showAll;
  if(!rankModalState.showAll)rankModalState.selected='';
  renderRankModal();
}
function openRankModal(key){
  rankModalState.key=key;
  rankModalState.mode=rankMode[key]||'amount';
  rankModalState.selected='';
  rankModalState.showAll=false;
  renderRankModal();
  document.getElementById('rank_modal').classList.add('open');
}
function closeRankModal(){document.getElementById('rank_modal').classList.remove('open')}
function openRankProjectFromModal(event,key){
  event.preventDefault();
  event.stopPropagation();
  closeRankModal();
  focusProject(rankModalState.key==='domestic'?'d':'o',key);
}

function buildSearchIndex(){
  searchIndex=[];
  [['d',DL],['d',DU],['d',DE],['d',DP],['o',OL],['o',OU],['o',OP]].forEach(function(group){
    group[1].forEach(function(it){
      searchIndex.push({tab:group[0],key:keyOf(it),item:it,text:(cleanTitle(it)+' '+(it.n||'')+' '+(it.m||'')+' '+(it.m2||'')).toLowerCase()});
    });
  });
}
function onSearch(q){
  var box=document.getElementById('search_results');
  q=String(q||'').trim().toLowerCase();
  if(!q){box.classList.remove('open');box.innerHTML='';return}
  if(addProjectMode&&looksLikeUrl(q)){box.classList.remove('open');box.innerHTML='';return}
  var rows=searchIndex.filter(function(r){return r.text.indexOf(q)>=0}).slice(0,8);
  box.innerHTML=rows.map(function(r){
    return '<button type="button" class="search-result" onclick="focusProject(\''+r.tab+'\',\''+escAttr(r.key)+'\')"><strong>'+escHtml(cleanTitle(r.item))+'</strong><span>'+escHtml(r.item.m||r.item.m2||'')+'</span></button>';
  }).join('')||'<button type="button" class="search-result"><strong>没有找到匹配项目</strong><span>换个关键词试试</span></button>';
  box.classList.add('open');
}
function searchKey(e){
  if(e.key==='Escape'){document.getElementById('search_results').classList.remove('open');exitAddMode()}
  if(e.key==='Enter'&&addProjectMode){e.preventDefault();submitSearchUrl()}
}
function focusProject(tab,key){
  document.getElementById('search_results').classList.remove('open');
  recordProjectEvent(key,'jump');
  st(tab);
  setTimeout(function(){
    var el=document.querySelector('[data-project-key="'+CSS.escape(key)+'"]');
    if(!el)return;
    el.scrollIntoView({behavior:'smooth',block:'center'});
    el.classList.add('highlight-card');
    if(el.classList.contains('card')){
      el.classList.add('open');
      viewStartMap[key]=Date.now();
      recordProjectEvent(key,'view');
    }
    setTimeout(function(){el.classList.remove('highlight-card')},1600);
  },80);
}

// Initial render
buildSearchIndex();
st('n');
setInterval(function(){st(currentTab)},600000);

var addProjectMode=false;
function enterAddMode(){
  addProjectMode=true;
  var wrap=document.getElementById('search_wrap'),input=document.getElementById('site_search'),btn=document.getElementById('add_game_btn');
  wrap.classList.add('add-mode');
  input.placeholder='粘贴众筹链接，按 Enter 或再点添加';
  input.focus();
  btn.textContent='添加';
  toast('可以直接粘贴链接，按 Enter 提交');
}
function exitAddMode(){
  addProjectMode=false;
  var wrap=document.getElementById('search_wrap'),input=document.getElementById('site_search'),btn=document.getElementById('add_game_btn');
  wrap.classList.remove('add-mode');
  input.placeholder='搜索项目，或点右侧添加项目';
  btn.textContent='+ 添加项目';
}
function handleAddProject(){
  var input=document.getElementById('site_search');
  if(!addProjectMode){enterAddMode();return}
  if(looksLikeUrl(input.value)){submitSearchUrl();return}
  input.focus();
  toast('先粘贴众筹项目链接');
}
function openFeedbackModal(){document.getElementById('feedback_modal').classList.add('open');document.getElementById('feedback_text').focus()}
function closeFeedbackModal(){document.getElementById('feedback_modal').classList.remove('open')}
function storeLocal(key,item){
  var rows=[];
  try{rows=JSON.parse(localStorage.getItem(key)||'[]')}catch(e){}
  rows.push(Object.assign({created_at:new Date().toISOString()},item));
  localStorage.setItem(key,JSON.stringify(rows));
}
function postOrStore(url,key,payload,done){
  fetch(url,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)})
    .then(function(r){if(!r.ok)throw new Error('pending backend');return r.json().catch(function(){return {}})})
    .then(function(){done(true)})
    .catch(function(){storeLocal(key,payload);done(false)});
}
function looksLikeUrl(v){return /^https?:\/\/\S+$/i.test(String(v||'').trim())}
function submitSearchUrl(){
  var input=document.getElementById('site_search');
  var url=input.value.trim();
  if(!looksLikeUrl(url)){toast('把众筹项目链接粘贴到搜索框，再点 +');return}
  var payload={url:url,source:'search_add'};
  postOrStore('/api/project-submissions','pending_project_submissions',payload,function(sent){
    input.value='';
    exitAddMode();
    document.getElementById('search_results').classList.remove('open');
    toast(sent?'链接已提交，等待审核':'链接已暂存，后台接好后可同步审核');
  });
}
function submitFeedback(){
  var payload={
    message:document.getElementById('feedback_text').value.trim(),
    contact:document.getElementById('feedback_contact').value.trim()
  };
  if(!payload.message){toast('先写一点建议吧');return}
  postOrStore('/api/feedback','pending_feedback',payload,function(sent){
    closeFeedbackModal();
    document.getElementById('feedback_text').value='';
    document.getElementById('feedback_contact').value='';
    toast(sent?'建议已提交':'建议已暂存，后台接好后可同步');
  });
}

// ===== 分享 & 二维码 =====
function loadScriptOnce(src,globalName){
  return new Promise(function(resolve,reject){
    if(globalName&&window[globalName]){resolve();return}
    var old=document.querySelector('script[src="'+src+'"]');
    if(old){old.addEventListener('load',resolve);old.addEventListener('error',reject);return}
    var s=document.createElement('script');
    var timer=setTimeout(function(){reject(new Error('script timeout'))},8000);
    s.src=src;s.async=true;
    s.onload=function(){clearTimeout(timer);resolve()};
    s.onerror=function(){clearTimeout(timer);reject(new Error('script load failed'))};
    document.head.appendChild(s);
  });
}
var currentShareBlob=null,currentShareUrl='';
function openShareModal(message){
  clearShareUrl();
  var modal=document.getElementById('share_modal'),hint=document.getElementById('share_hint'),preview=document.getElementById('share_preview'),actions=document.getElementById('share_actions');
  if(hint)hint.textContent=message||'正在生成...';
  if(preview)preview.innerHTML='<div style="padding:28px;text-align:center;color:#86868b;font-size:13px">生成中...</div>';
  if(actions)actions.innerHTML='';
  if(modal)modal.classList.add('open');
}
function closeShareModal(){
  document.getElementById('share_modal').classList.remove('open');
}
function clearShareUrl(){
  if(currentShareUrl){URL.revokeObjectURL(currentShareUrl);currentShareUrl=''}
}
function roundRect(ctx,x,y,w,h,r){
  ctx.beginPath();ctx.moveTo(x+r,y);ctx.arcTo(x+w,y,x+w,y+h,r);ctx.arcTo(x+w,y+h,x,y+h,r);ctx.arcTo(x,y+h,x,y,r);ctx.arcTo(x,y,x+w,y,r);ctx.closePath();
}
function withTimeout(promise,ms,label){
  return Promise.race([
    promise,
    new Promise(function(_,reject){setTimeout(function(){reject(new Error(label||'timeout'))},ms)})
  ]);
}
function waitForShareImages(root){
  var imgs=Array.prototype.slice.call((root||document).querySelectorAll('img'));
  imgs.forEach(function(img){
    img.loading='eager';
    if(img.dataset&&img.dataset.src&&!img.getAttribute('src'))img.setAttribute('src',img.dataset.src);
  });
  return Promise.all(imgs.map(function(img){
    if(img.complete&&img.naturalWidth>0)return Promise.resolve();
    if(img.decode){
      var decoded=img.decode().catch(function(){
        return new Promise(function(resolve){
          img.addEventListener('load',resolve,{once:true});
          img.addEventListener('error',resolve,{once:true});
          setTimeout(resolve,4500);
        });
      });
      return Promise.race([
        decoded,
        new Promise(function(resolve){setTimeout(resolve,4500)})
      ]);
    }
    return new Promise(function(resolve){
      img.addEventListener('load',resolve,{once:true});
      img.addEventListener('error',resolve,{once:true});
      setTimeout(resolve,4500);
    });
  }));
}
function hideForScreenshot(on){
  ['#share_modal','.toast','.back-top'].forEach(function(sel){
    document.querySelectorAll(sel).forEach(function(el){
      if(on){
        el.dataset.ssDisplay=el.style.display||'';
        el.style.display='none';
      }else if(el.dataset.ssDisplay!==undefined){
        el.style.display=el.dataset.ssDisplay;
        delete el.dataset.ssDisplay;
      }
    });
  });
}
function buildScreenshotTarget(){
  var source=document.querySelector('.container')||document.body;
  var wrap=document.createElement('div');
  wrap.className='container screenshot-capture-root';
  wrap.style.position='absolute';
  wrap.style.left='-10000px';
  wrap.style.top='0';
  wrap.style.width=source.getBoundingClientRect().width+'px';
  wrap.style.background='#f5f5f7';
  wrap.style.padding='0';
  var header=document.querySelector('header');
  var tabs=document.querySelector('.tab-bar');
  var active=document.querySelector('.tab-content.active');
  var footer=document.querySelector('footer');
  var contentPart=active;
  var openCard=active&&active.querySelector('.card.open');
  if(openCard){
    contentPart=document.createElement('div');
    contentPart.className='tab-content active';
    var prev=openCard.previousElementSibling;
    while(prev&&!(prev.classList&&prev.classList.contains('sec')))prev=prev.previousElementSibling;
    if(prev)contentPart.appendChild(prev.cloneNode(true));
    contentPart.appendChild(openCard.cloneNode(true));
  }
  [header,tabs,contentPart,footer].forEach(function(part){
    if(part)wrap.appendChild(part.cloneNode(true));
  });
  wrap.querySelectorAll('[hidden]').forEach(function(el){el.hidden=false});
  return wrap;
}
async function captureVisibleScreen(){
  if(!navigator.mediaDevices||!navigator.mediaDevices.getDisplayMedia)return false;
  toast('请选择当前网页窗口进行截图');
  var stream=await navigator.mediaDevices.getDisplayMedia({
    video:{displaySurface:'browser'},
    audio:false
  });
  try{
    var video=document.createElement('video');
    video.muted=true;
    video.playsInline=true;
    video.srcObject=stream;
    await video.play();
    await new Promise(function(resolve){
      if(video.videoWidth)resolve();
      else video.onloadedmetadata=resolve;
    });
    var c=document.createElement('canvas'),ctx=c.getContext('2d');
    c.width=video.videoWidth||window.innerWidth;
    c.height=video.videoHeight||window.innerHeight;
    ctx.drawImage(video,0,0,c.width,c.height);
    showSharePreviewFromCanvas(c);
    return true;
  }finally{
    stream.getTracks().forEach(function(track){track.stop()});
  }
}
async function capturePageLongImage(){
  await loadScriptOnce('assets/html2canvas.min.js','html2canvas');
  var target=buildScreenshotTarget();
  document.body.appendChild(target);
  await waitForShareImages(target);
  hideForScreenshot(true);
  await new Promise(function(resolve){requestAnimationFrame(function(){requestAnimationFrame(resolve)})});
  var cssHeight=Math.max(target.scrollHeight,target.offsetHeight,document.documentElement.clientHeight);
  var scale=cssHeight>3200?1:Math.min(2,window.devicePixelRatio||1.5);
  try{
    var canvas=await withTimeout(html2canvas(target,{
      backgroundColor:'#f5f5f7',
      scale:scale,
      useCORS:true,
      allowTaint:false,
      logging:false,
      imageTimeout:8000,
      scrollX:0,
      scrollY:-window.scrollY,
      windowWidth:document.documentElement.scrollWidth,
      windowHeight:document.documentElement.scrollHeight,
      ignoreElements:function(el){
        return el.classList&&(
          el.classList.contains('modal-backdrop')||
          el.classList.contains('toast')||
          el.classList.contains('back-top')
        );
      }
    }),30000,'capture timeout');
    showSharePreviewFromCanvas(canvas);
  }finally{
    hideForScreenshot(false);
    if(target&&target.parentNode)target.parentNode.removeChild(target);
  }
}
async function doShare(){
  try{
    closeShareModal();
    var usedScreen=false;
    try{usedScreen=await captureVisibleScreen()}
    catch(permissionError){
      usedScreen=false;
    }
    if(!usedScreen){
      openShareModal('正在生成网页截图，图片较多时需要稍等...');
      toast('正在生成网页长截图...');
      await capturePageLongImage();
    }
  }catch(e){
    hideForScreenshot(false);
    toast('网页截图生成失败，请稍后重试');
  }
}
function saveCanvas(canvas){
  canvas.toBlob(function(blob){
    if(blob)downloadShareBlob(blob);
    else toast('截图生成失败，请稍后重试');
  },'image/png',0.92);
}
function downloadShareBlob(blob){
  clearShareUrl();
  currentShareBlob=blob;
  currentShareUrl=URL.createObjectURL(blob);
  try{
    var file=new File([blob],'爱玩桌游众筹资讯.png',{type:'image/png'});
    if(navigator.canShare&&navigator.canShare({files:[file]})){
      navigator.share({title:'爱玩桌游众筹资讯',files:[file]})
        .then(function(){toast('截图已唤起分享')})
        .catch(function(){showSharePreview(blob)});
      return;
    }
  }catch(e){}
  showSharePreview(blob);
}
function showSharePreviewFromCanvas(canvas){
  canvas.toBlob(function(blob){if(blob)showSharePreview(blob);else toast('截图生成失败')},'image/png',0.92);
}
function showSharePreview(blob){
  clearShareUrl();
  currentShareBlob=blob;
  currentShareUrl=URL.createObjectURL(blob);
  var modal=document.getElementById('share_modal'),preview=document.getElementById('share_preview'),hint=document.getElementById('share_hint'),actions=document.getElementById('share_actions');
  if(modal)modal.classList.add('open');
  if(hint)hint.textContent='已生成图片，长按图片可保存或转发。';
  if(preview)preview.innerHTML='<img src="'+currentShareUrl+'" alt="分享截图">';
  var html='<button type="button" onclick="closeShareModal()">完成</button><a id="share_download_link" class="primary" href="'+currentShareUrl+'" download="爱玩桌游众筹资讯.png">保存图片</a>';
  try{
    var file=new File([blob],'爱玩桌游众筹资讯.png',{type:'image/png'});
    if(navigator.canShare&&navigator.canShare({files:[file]})){
      html='<button type="button" onclick="closeShareModal()">完成</button><button type="button" class="primary" onclick="shareCurrentImage()">系统分享</button><a id="share_download_link" href="'+currentShareUrl+'" download="爱玩桌游众筹资讯.png">保存图片</a>';
    }
  }catch(e){}
  if(actions)actions.innerHTML=html;
  toast('截图已生成');
}
async function shareCurrentImage(){
  if(!currentShareBlob)return;
  var file=new File([currentShareBlob],'爱玩桌游众筹资讯.png',{type:'image/png'});
  try{await navigator.share({title:'爱玩桌游众筹资讯',files:[file]});toast('截图已唤起分享')}catch(e){toast('可以长按图片保存或转发')}
}
function toast(msg){
  var el=document.querySelector('.toast');
  if(!el){el=document.createElement('div');el.className='toast';document.body.appendChild(el)}
  el.textContent=msg;el.classList.add('show');
  setTimeout(function(){el.classList.remove('show')},2000);
}
// Load QR code library and generate
var qrLoaded=false;
function loadQR(){
  if(qrLoaded)return;qrLoaded=true;
  if(typeof QRCode!=='undefined'){genQR();return}
  var s=document.createElement('script');
  s.src='https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js';
  s.async=true;
  s.onload=genQR;s.onerror=genQR_fallback;
  document.head.appendChild(s);
}
function genQR(){
  var el=document.getElementById('qr_canvas');
  if(!el||!window.QRCode)return;
  try{new QRCode(el,{text:'https://aiwanlands.com',width:140,height:140});}catch(e){genQR_fallback()}
}
function genQR_fallback(){
  var el=document.getElementById('qr_canvas');
  if(!el)return;
  el.innerHTML='<a href="https://aiwanlands.com" style="display:flex;flex-direction:column;align-items:center;gap:4px;text-decoration:none;color:inherit;font-size:.72em">'+
    '<svg width="80" height="80" viewBox="0 0 21 21" style="opacity:.7"><rect x="1" y="1" width="7" height="7" fill="currentColor"/><rect x="9" y="1" width="3" height="3" fill="currentColor"/><rect x="17" y="1" width="3" height="7" fill="currentColor"/><rect x="1" y="9" width="3" height="3" fill="currentColor"/><rect x="13" y="9" width="3" height="3" fill="currentColor"/><rect x="17" y="9" width="3" height="3" fill="currentColor"/><rect x="1" y="13" width="7" height="7" fill="currentColor"/><rect x="9" y="13" width="3" height="3" fill="currentColor"/><rect x="13" y="17" width="7" height="3" fill="currentColor"/></svg>'+
    '<span>aiwanlands.com</span></a>';
}
// Load QR on hover
loadQR();
document.addEventListener('keydown',function(e){if(e.key==='Escape'){closeFeedbackModal();closeRankModal();exitAddMode()}});
document.addEventListener('click',function(e){
  var wrap=document.getElementById('search_wrap');
  if(addProjectMode&&wrap&&!wrap.contains(e.target)){
    exitAddMode();
    document.getElementById('search_results').classList.remove('open');
  }
});
function scrollTopPage(){window.scrollTo({top:0,behavior:'smooth'})}
function syncBackTop(){
  var btn=document.getElementById('back_top');
  if(btn)btn.classList.toggle('show',window.scrollY>360);
}
window.addEventListener('scroll',syncBackTop,{passive:true});
window.addEventListener('beforeunload',function(){
  Object.keys(viewStartMap).forEach(recordViewDuration);
});
syncBackTop();

</script>
</body>
</html>
